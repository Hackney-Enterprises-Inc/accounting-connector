# Credentials for the contract suite (composer test:contract), which makes REAL
# calls to a Xero Demo Company. Copy to .env.contract (gitignored) and fill in.
#
# These names are deliberately different from the application's XERO_CLIENT_ID and
# XERO_CLIENT_SECRET: the app's test suite scrubs those so it can never reach Xero,
# and nothing here can leak into it.
#
# Every variable below is required; the suite skips itself and names the missing
# one otherwise.

# The OAuth app the Demo Company was connected through (any Xero login can create
# one at developer.xero.com; the Demo Company is free with any Xero account).
XERO_CONTRACT_CLIENT_ID=
XERO_CONTRACT_CLIENT_SECRET=

# The Demo Company's tenant id, from the connections call after authorising.
XERO_CONTRACT_TENANT_ID=

# A JSON file holding {"access_token": "...", "refresh_token": "...", "expires_at": <unix seconds>}.
# Relative paths resolve from the package root. The suite REWRITES this file when
# Xero rotates the refresh token, so it must be writable and must not be shared
# with anything else that refreshes the same token.
XERO_CONTRACT_TOKEN_FILE=tests/Contract/.xero-token.json

# Optional. When absent the suite uses the first bank account and the first expense
# account it finds in the Demo Company's chart.
# XERO_CONTRACT_BANK_ACCOUNT_ID=
# XERO_CONTRACT_EXPENSE_ACCOUNT_CODE=
